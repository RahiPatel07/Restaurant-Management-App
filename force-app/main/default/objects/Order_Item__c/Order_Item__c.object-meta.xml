<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Order Item</label>
    <pluralLabel>Order Items</pluralLabel>
    <nameField>
        <label>Order Item Name</label>
        <type>Text</type>
    </nameField>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Line item within an Order.</description>
    <enableActivities>false</enableActivities>
    <enableHistory>true</enableHistory>
    <sharingModel>ControlledByParent</sharingModel>
    <fields>
        <fullName>Order__c</fullName>
        <description>The parent order.</description>
        <externalId>false</externalId>
        <label>Order</label>
        <referenceTo>Order__c</referenceTo>
        <relationshipLabel>Order Items</relationshipLabel>
        <relationshipName>Order_Items</relationshipName>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
    </fields>
    <fields>
        <fullName>Menu_Item__c</fullName>
        <description>The related menu item.</description>
        <externalId>false</externalId>
        <label>Menu Item</label>
        <deleteConstraint>Restrict</deleteConstraint>
        <referenceTo>Menu_Item__c</referenceTo>
        <relationshipLabel>Order Items</relationshipLabel>
        <relationshipName>Menu_Order_Items</relationshipName>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Quantity__c</fullName>
        <description>Quantity ordered.</description>
        <externalId>false</externalId>
        <label>Quantity</label>
        <precision>6</precision>
        <scale>0</scale>
        <required>true</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
    </fields>
    <fields>
        <fullName>Unit_Price__c</fullName>
        <description>Unit price at the time of ordering.</description>
        <externalId>false</externalId>
        <label>Unit Price</label>
        <precision>8</precision>
        <scale>2</scale>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Line_Total__c</fullName>
        <description>Extended amount for this line.</description>
        <externalId>false</externalId>
        <label>Line Total</label>
        <precision>10</precision>
        <scale>2</scale>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Status__c</fullName>
        <description>Status of this order item.</description>
        <externalId>false</externalId>
        <label>Status</label>
        <required>true</required>
        <trackHistory>true</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Pending</fullName>
                    <default>true</default>
                    <label>Pending</label>
                </value>
                <value>
                    <fullName>Confirmed</fullName>
                    <default>false</default>
                    <label>Confirmed</label>
                </value>
                <value>
                    <fullName>Preparing</fullName>
                    <default>false</default>
                    <label>Preparing</label>
                </value>
                <value>
                    <fullName>Ready</fullName>
                    <default>false</default>
                    <label>Ready</label>
                </value>
                <value>
                    <fullName>Delivered</fullName>
                    <default>false</default>
                    <label>Delivered</label>
                </value>
                <value>
                    <fullName>Cancelled</fullName>
                    <default>false</default>
                    <label>Cancelled</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Estimated_Delivery_Time__c</fullName>
        <description>Estimated minutes until first item is served.</description>
        <externalId>false</externalId>
        <label>Estimated Delivery (min)</label>
        <precision>4</precision>
        <scale>0</scale>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
    </fields>
</CustomObject>

