<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Order</label>
    <pluralLabel>Orders</pluralLabel>
    <nameField>
        <label>Order Number</label>
        <type>AutoNumber</type>
        <displayFormat>ORD-{00000}</displayFormat>
    </nameField>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Represents a customer order for a specific table.</description>
    <enableActivities>true</enableActivities>
    <enableHistory>true</enableHistory>
    <sharingModel>ReadWrite</sharingModel>
    <fields>
        <fullName>Restaurant__c</fullName>
        <description>The restaurant where this order is placed.</description>
        <externalId>false</externalId>
        <label>Restaurant</label>
        <deleteConstraint>Restrict</deleteConstraint>
        <referenceTo>Restaurant__c</referenceTo>
        <relationshipLabel>Orders</relationshipLabel>
        <relationshipName>Orders</relationshipName>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Table__c</fullName>
        <description>The table associated with this order.</description>
        <externalId>false</externalId>
        <label>Table</label>
        <deleteConstraint>Restrict</deleteConstraint>
        <referenceTo>Table__c</referenceTo>
        <relationshipLabel>Orders</relationshipLabel>
        <relationshipName>Table_Orders</relationshipName>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Status__c</fullName>
        <description>Status of the order.</description>
        <externalId>false</externalId>
        <label>Status</label>
        <required>true</required>
        <trackHistory>true</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Open</fullName>
                    <default>true</default>
                    <label>Open</label>
                </value>
                <value>
                    <fullName>Completed</fullName>
                    <default>false</default>
                    <label>Completed</label>
                </value>
                <value>
                    <fullName>Paid</fullName>
                    <default>false</default>
                    <label>Paid</label>
                </value>
                <value>
                    <fullName>Cancelled</fullName>
                    <default>false</default>
                    <label>Cancelled</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Total_Amount__c</fullName>
        <description>Sum of the line item amounts before tax and tip.</description>
        <externalId>false</externalId>
        <label>Total Amount</label>
        <precision>10</precision>
        <scale>2</scale>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Tax_Amount__c</fullName>
        <description>Tax applied to this order.</description>
        <externalId>false</externalId>
        <label>Tax Amount</label>
        <precision>10</precision>
        <scale>2</scale>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Tip_Amount__c</fullName>
        <description>Tip provided by the customer.</description>
        <externalId>false</externalId>
        <label>Tip Amount</label>
        <precision>10</precision>
        <scale>2</scale>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Grand_Total__c</fullName>
        <description>Total amount including tax and tip.</description>
        <externalId>false</externalId>
        <label>Grand Total</label>
        <precision>10</precision>
        <scale>2</scale>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Order_Start_Time__c</fullName>
        <description>When the customer was seated / order opened.</description>
        <externalId>false</externalId>
        <label>Order Start Time</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Order_End_Time__c</fullName>
        <description>When the order was completed/paid.</description>
        <externalId>false</externalId>
        <label>Order End Time</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
</CustomObject>

