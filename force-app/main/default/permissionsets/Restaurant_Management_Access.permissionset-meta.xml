        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>true</modifyAllRecords>
        <viewAllRecords>true</viewAllRecords>
        <object>Restaurant__c</object>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>true</modifyAllRecords>
        <viewAllRecords>true</viewAllRecords>
        <object>Table__c</object>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>true</modifyAllRecords>
        <viewAllRecords>true</viewAllRecords>
        <object>Menu_Item__c</object>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>true</modifyAllRecords>
        <viewAllRecords>true</viewAllRecords>
        <object>Order__c</object>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>true</modifyAllRecords>
        <viewAllRecords>true</viewAllRecords>
        <object>Order_Item__c</object>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>true</modifyAllRecords>
        <viewAllRecords>true</viewAllRecords>
        <object>Inventory_Item__c</object>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>true</modifyAllRecords>
        <viewAllRecords>true</viewAllRecords>
        <object>Feedback__c</object>
    </objectPermissions>

    <!-- Apex class access -->
    <classAccesses>
        <apexClass>RestaurantOrderService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>MenuItemListController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>TableController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>ChefListController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>WaiterListController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>Bill</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>RestaurantContextController</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <!-- Field-level security -->
    <fieldPermissions><editable>true</editable><field>Restaurant__c.Location__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Restaurant__c.Is_Active__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Restaurant__c.Active_Chef_Count__c</field><readable>true</readable></fieldPermissions>

    <fieldPermissions><editable>true</editable><field>Order__c.Total_Amount__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Order__c.Tax_Amount__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Order__c.Tip_Amount__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Order__c.Grand_Total__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Order__c.Order_Start_Time__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Order__c.Order_End_Time__c</field><readable>true</readable></fieldPermissions>

    <fieldPermissions><editable>true</editable><field>Order_Item__c.Line_Total__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Order_Item__c.Estimated_Delivery_Time__c</field><readable>true</readable></fieldPermissions>

    <fieldPermissions><editable>true</editable><field>Inventory_Item__c.Menu_Item__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Inventory_Item__c.Reorder_Threshold__c</field><readable>true</readable></fieldPermissions>
