    <fieldPermissions><editable>true</editable><field>Feedback__c.Food_Rating__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Feedback__c.Service_Rating__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Feedback__c.Comments__c</field><readable>true</readable></fieldPermissions>

    <!-- Required custom fields: omit fieldPermissions — Salesforce blocks FLS deploy on required fields; object CRUD grants access. -->

    <fieldPermissions><editable>true</editable><field>Menu_Item__c.Restaurant__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Menu_Item__c.Is_Top_Seller__c</field><readable>true</readable></fieldPermissions>

    <fieldPermissions><editable>true</editable><field>Feedback__c.Restaurant__c</field><readable>true</readable></fieldPermissions>

